---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

const agents = await getCollection("agents", ({ data }) => !data.draft);
// Sort by pubDatetime ascending (00 → 19, with plan.md at the start)
const sorted = agents.sort(
  (a, b) =>
    new Date(a.data.pubDatetime).getTime() -
    new Date(b.data.pubDatetime).getTime()
);

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`Hermes Agent 系列 | ${config.site.title}`}
  description="Hermes Agent 项目的系统性梳理,20+ 篇深度文档覆盖架构、记忆、上下文、工具、技能、插件、MCP、子代理、沙箱、Hooks、配置、CLI、可观测性、测试、面试题与量化指标。带 Mermaid 图与可量化数据。"
>
  <Header />

  <Main
    pageTitle="🤖 Hermes Agent 系列"
    pageDesc="基于 Nous Research 开源项目的系统性梳理,20+ 篇深度文档,带 Mermaid 图与可量化数据。"
  >
    <div class="mb-8 rounded-lg border border-border/50 bg-card p-4 text-sm">
      <p>
        项目根目录:<code class="rounded bg-muted px-1.5 py-0.5">D:\hans\proj\hermes-agent</code> ·
        版本 <code class="rounded bg-muted px-1.5 py-0.5">0.18.2</code> ·
        License MIT ·
        维护方 Nous Research
      </p>
      <p class="mt-2 text-foreground/70">
        阅读建议:<strong class="text-accent">面试突击 60 分钟</strong>
        路径 A,先看 00 → 02 → 18;<strong class="text-accent">深度掌握 4 小时</strong>
        路径 B,顺序读 00 → 12 后细看 03 / 06 / 10 / 11,最后看 17 / 19。
      </p>
    </div>

    <ul class="space-y-6">
      {
        sorted.map(entry => (
          <li class="rounded-lg border border-border/50 bg-card p-5 transition-colors hover:border-accent/50">
            <a
              href={`/agents/${entry.id}/`}
              class="block no-underline"
            >
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="text-lg font-semibold text-accent">
                  {entry.data.title}
                </h2>
                <Datetime
                  pubDatetime={entry.data.pubDatetime}
                  modDatetime={entry.data.modDatetime}
                  size="sm"
                />
              </div>
              <p class="mt-2 text-sm text-foreground/75">
                {entry.data.description}
              </p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {entry.data.tags.map(tag => (
                  <Tag
                    tag={slugifyStr(tag)}
                    tagName={tag}
                    size="sm"
                  />
                ))}
              </ul>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
