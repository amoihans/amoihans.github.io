---
import { getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import BackButton from "@/pages/posts/[...slug]/_components/BackButton.astro";
import BackToTopButton from "@/pages/posts/[...slug]/_components/BackToTopButton.astro";
import AdjacentPostNav from "@/pages/posts/[...slug]/_components/AdjacentPostNav.astro";
import ShareLinks from "@/pages/posts/[...slug]/_components/ShareLinks.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

export async function getStaticPaths() {
  const agents = await getCollection("agents");
  // Filter drafts and sort by pubDatetime ascending (00 → 19, plan first)
  const visible = agents
    .filter(({ data }) => !data.draft)
    .sort(
      (a, b) =>
        new Date(a.data.pubDatetime).getTime() -
        new Date(b.data.pubDatetime).getTime()
    );

  return visible.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev:
        index > 0
          ? {
              id: visible[index - 1].id,
              title: visible[index - 1].data.title,
              filePath: visible[index - 1].filePath,
            }
          : null,
      next:
        index < visible.length - 1
          ? {
              id: visible[index + 1].id,
              title: visible[index + 1].data.title,
              filePath: visible[index + 1].filePath,
            }
          : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
} = entry.data;

const { Content } = await render(entry);

// AdjacentPostNav expects CollectionEntry<"posts">, but it only uses
// .id / .title / .filePath. Cast through unknown to reuse the component.
const castedPrev = prev as unknown as Parameters<typeof AdjacentPostNav>[0]["prevPost"];
const castedNext = next as unknown as Parameters<typeof AdjacentPostNav>[0]["nextPost"];

let ogImageUrl: string | undefined;
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}
if (!ogImageUrl && config.features.dynamicOgImage) {
  ogImageUrl = `/agents/${entry.id}/index.png`;
}
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <div id="post-page" class="mx-auto w-full max-w-6xl px-4">
    <Header />

    <BackButton />

    <main
      id="main-content"
      class:list={[{ "mt-8": !config.features.showBackButton }]}
      data-pagefind-body
    >
      <div class="flex gap-8 xl:gap-12">
        <div class="min-w-0 flex-1">
          <h1
            class="text-accent inline-block text-2xl font-bold sm:text-3xl"
          >
            {title}
          </h1>

          <div class="my-2 flex items-center gap-2">
            <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
          </div>

          <article
            id="article"
            class:list={[
              "mt-8 w-full",
              "app-prose",
              "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
            ]}
          >
            <Content />
          </article>

          <hr class="my-8 border-dashed" />

          <BackToTopButton />

          <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
            {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
          </ul>

          <ShareLinks />

          <hr class="my-8 border-dashed" />

          <AdjacentPostNav prevPost={castedPrev} nextPost={castedNext} />
        </div>

        <TableOfContents />
      </div>
    </main>
    <Footer />
  </div>
</PostLayout>

<style is:global>
  #post-page .app-layout {
    max-width: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  #post-page header .border-border {
    padding-left: 0;
    padding-right: 0;
  }
</style>
