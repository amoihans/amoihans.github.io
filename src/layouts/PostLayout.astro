---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const { title, description, ogImage, canonicalURL, pubDatetime, modDatetime } =
  Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? site.title,
  image: ogImage,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>

<script is:inline>
  // 存储 Mermaid 主题 CSS，导出时把它内联进 SVG
  // （否则 PNG/剪贴板会丢样式，因为 Mermaid 用 class 引用页面 CSS）
  let mermaidThemeCSS = "";

  // Mermaid 主题样式，集中维护一份
  const MERMAID_THEME_CSS = `
          /* ── border radius ── */
          .node rect, .node circle, .node ellipse, .node polygon,
          .cluster rect, .label foreignObject, .edgeLabel foreignObject {
            rx: 8px !important;
            ry: 8px !important;
          }
          /* ── thinner lines ── */
          .edgePath .path, .flowchart-link, .messageLine0, .messageLine1 {
            stroke-width: 1.5px !important;
          }
          .node rect, .node circle, .node ellipse, .node polygon {
            stroke-width: 1.5px !important;
          }
          /* ── subtle shadow on nodes ── */
          .node rect {
            filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.06));
          }
          /* ── cluster / subgraph styling ── */
          .cluster rect {
            stroke-dasharray: 6 3;
            stroke-width: 1px !important;
          }
          /* ── edge labels ── */
          .edgeLabel span {
            font-size: 12px;
            letter-spacing: 0.01em;
          }
          /* ── sequence diagram actors ── */
          .actor {
            rx: 6px !important;
            ry: 6px !important;
          }
          /* ── Mermaid 全屏查看按钮（hover 显示） ── */
          .mermaid-container:focus-visible {
            outline: 2px solid rgb(99 102 241);
            outline-offset: 2px;
          }
        `;

  // Mermaid diagram client-side rendering
  async function renderMermaidDiagrams() {
    const mermaidPres = document.querySelectorAll(
      'pre[data-language="mermaid"]'
    );
    if (mermaidPres.length === 0) return;

    try {
      const mermaid = await import(
        "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
      );
      const isDark =
        document.documentElement.dataset.theme === "dark";

      mermaid.default.initialize({
        startOnLoad: false,
        theme: "base",
        securityLevel: "loose",
        fontFamily:
          '"PingFang SC", "Microsoft YaHei", "Hiragino Sans GB", system-ui, -apple-system, sans-serif',
        themeVariables: isDark
          ? {
              // ── Dark mode ──────────────────────────────
              background: "#0f172a",
              primaryColor: "#4f46e5",
              primaryTextColor: "#e0e7ff",
              primaryBorderColor: "#818cf8",
              lineColor: "#475569",
              secondaryColor: "#1e293b",
              secondaryTextColor: "#cbd5e1",
              secondaryBorderColor: "#334155",
              tertiaryColor: "#0f1f1a",
              tertiaryTextColor: "#a7f3d0",
              tertiaryBorderColor: "#065f46",
              // Node styling
              mainBkg: "#0f172a",
              nodeBorder: "#475569",
              nodeTextColor: "#e2e8f0",
              // Edge / label
              edgeLabelBackground: "#1e293b",
              labelTextColor: "#94a3b8",
              labelBackground: "#1e293b",
              // Cluster (subgraph)
              clusterBkg: "#1e293b",
              clusterBorder: "#334155",
              // Title
              titleColor: "#e2e8f0",
              // Flowchart specific
              nodePadding: "10",
              // Sequence diagram
              actorBkg: "#4f46e5",
              actorBorder: "#818cf8",
              actorTextColor: "#e0e7ff",
              actorLineColor: "#64748b",
              signalColor: "#94a3b8",
              signalTextColor: "#e2e8f0",
              labelBoxBkgColor: "#1e293b",
              labelBoxBorderColor: "#334155",
              loopTextColor: "#e2e8f0",
              noteBkgColor: "#312e81",
              noteBorderColor: "#6366f1",
              noteTextColor: "#c7d2fe",
              // State diagram
              labelColor: "#e2e8f0",
              altBackground: "#1e293b",
              // ER / class diagram
              classText: "#e2e8f0",
              fillType0: "#4f46e5",
              fillType1: "#0891b2",
              fillType2: "#7c3aed",
              fillType3: "#059669",
              fillType4: "#d97706",
              fillType5: "#dc2626",
              fillType6: "#2563eb",
              fillType7: "#9333ea",
              // Gantt
              sectionBkgColor: "#1e293b",
              altSectionBkgColor: "#0f172a",
              sectionBkgColor2: "#1e293b",
              taskBkgColor: "#4f46e5",
              taskBorderColor: "#818cf8",
              taskTextColor: "#e0e7ff",
              taskTextOutsideColor: "#cbd5e1",
              gridColor: "#334155",
              todayLineColor: "#f59e0b",
              // Pie
              pie1: "#4f46e5",
              pie2: "#0891b2",
              pie3: "#7c3aed",
              pie4: "#059669",
              pie5: "#d97706",
              pie6: "#dc2626",
              pie7: "#2563eb",
              pie8: "#9333ea",
              pieTitleTextColor: "#e2e8f0",
              pieSectionTextColor: "#cbd5e1",
              pieLegendTextColor: "#cbd5e1",
              pieStrokeColor: "#0f172a",
            }
          : {
              // ── Light mode ─────────────────────────────
              background: "#ffffff",
              primaryColor: "#4f46e5",
              primaryTextColor: "#ffffff",
              primaryBorderColor: "#6366f1",
              lineColor: "#94a3b8",
              secondaryColor: "#f8fafc",
              secondaryTextColor: "#334155",
              secondaryBorderColor: "#cbd5e1",
              tertiaryColor: "#f0fdf4",
              tertiaryTextColor: "#065f46",
              tertiaryBorderColor: "#6ee7b7",
              // Node styling
              mainBkg: "#ffffff",
              nodeBorder: "#cbd5e1",
              nodeTextColor: "#1e293b",
              // Edge / label
              edgeLabelBackground: "#ffffff",
              labelTextColor: "#64748b",
              labelBackground: "#f1f5f9",
              // Cluster (subgraph)
              clusterBkg: "#f8fafc",
              clusterBorder: "#e2e8f0",
              // Title
              titleColor: "#1e293b",
              // Flowchart specific
              nodePadding: "10",
              // Sequence diagram
              actorBkg: "#4f46e5",
              actorBorder: "#6366f1",
              actorTextColor: "#ffffff",
              actorLineColor: "#94a3b8",
              signalColor: "#475569",
              signalTextColor: "#1e293b",
              labelBoxBkgColor: "#f8fafc",
              labelBoxBorderColor: "#e2e8f0",
              loopTextColor: "#1e293b",
              noteBkgColor: "#eef2ff",
              noteBorderColor: "#6366f1",
              noteTextColor: "#3730a3",
              // State diagram
              labelColor: "#1e293b",
              altBackground: "#f8fafc",
              // ER / class diagram
              classText: "#1e293b",
              fillType0: "#4f46e5",
              fillType1: "#0891b2",
              fillType2: "#7c3aed",
              fillType3: "#059669",
              fillType4: "#d97706",
              fillType5: "#dc2626",
              fillType6: "#2563eb",
              fillType7: "#9333ea",
              // Gantt
              sectionBkgColor: "#f8fafc",
              altSectionBkgColor: "#ffffff",
              sectionBkgColor2: "#f8fafc",
              taskBkgColor: "#4f46e5",
              taskBorderColor: "#6366f1",
              taskTextColor: "#ffffff",
              taskTextOutsideColor: "#475569",
              gridColor: "#e2e8f0",
              todayLineColor: "#dc2626",
              // Pie
              pie1: "#4f46e5",
              pie2: "#0891b2",
              pie3: "#7c3aed",
              pie4: "#059669",
              pie5: "#d97706",
              pie6: "#dc2626",
              pie7: "#2563eb",
              pie8: "#9333ea",
              pieTitleTextColor: "#1e293b",
              pieSectionTextColor: "#475569",
              pieLegendTextColor: "#475569",
              pieStrokeColor: "#ffffff",
            },
        themeCSS: MERMAID_THEME_CSS,
      });
      // 存一份供导出 SVG 时内联用
      mermaidThemeCSS = MERMAID_THEME_CSS;

      for (const pre of mermaidPres) {
        const code = pre.querySelector("code");
        if (!code) continue;
        const graphDefinition = code.textContent || "";
        const id = "mermaid-" + Math.random().toString(36).slice(2, 8);
        try {
          const { svg } = await mermaid.default.render(id, graphDefinition);
          const container = document.createElement("div");
          container.className =
            "mermaid-container group relative my-8 flex justify-center overflow-x-auto rounded-2xl border border-border/50 bg-card p-4 shadow-sm cursor-zoom-in";
          container.title = "点击全屏查看";
          container.innerHTML = svg;

          // ── 添加"全屏"按钮（hover 时浮现） ─────────────
          const fsBtn = document.createElement("button");
          fsBtn.type = "button";
          fsBtn.className =
            "mermaid-fs-btn absolute right-2 top-2 z-10 inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border/60 bg-background/80 text-foreground/80 opacity-0 backdrop-blur transition-all hover:bg-background hover:text-foreground group-hover:opacity-100";
          fsBtn.title = "全屏查看 (F)";
          fsBtn.setAttribute("aria-label", "全屏查看此图表");
          fsBtn.innerHTML =
            '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>';
          fsBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            openMermaidModal(svg, graphDefinition);
          });
          container.appendChild(fsBtn);

          // ── 点击容器任意位置也进入全屏 ─────────────────
          container.addEventListener("click", () => {
            openMermaidModal(svg, graphDefinition);
          });
          // ── 键盘快捷键：聚焦后按 F 进入全屏 ───────────
          container.tabIndex = 0;
          container.addEventListener("keydown", (e) => {
            if (e.key === "f" || e.key === "F") {
              e.preventDefault();
              openMermaidModal(svg, graphDefinition);
            }
          });

          pre.replaceWith(container);
        } catch (err) {
          console.warn("Mermaid render failed for diagram:", err);
        }
      }
    } catch (err) {
      console.warn("Mermaid CDN load failed:", err);
    }
  }

  renderMermaidDiagrams();
  document.addEventListener("astro:after-swap", renderMermaidDiagrams);

  // ─────────────────────────────────────────────────────
  //  Mermaid 全屏查看 Modal（单例、惰性创建）
  // ─────────────────────────────────────────────────────
  let mermaidModal = null;
  let mermaidModalState = { scale: 1, tx: 0, ty: 0, dragging: false };

  function ensureMermaidModal() {
    if (mermaidModal) return mermaidModal;
    mermaidModal = document.createElement("div");
    mermaidModal.id = "mermaid-modal";
    mermaidModal.setAttribute("role", "dialog");
    mermaidModal.setAttribute("aria-modal", "true");
    mermaidModal.className =
      "mermaid-modal fixed inset-0 z-50 hidden flex flex-col bg-background/95 backdrop-blur-sm";
    mermaidModal.innerHTML = `
      <div class="mermaid-modal-toolbar flex shrink-0 items-center justify-between gap-2 border-b border-border/60 bg-background/90 px-3 py-2">
        <div class="flex min-w-0 items-center gap-2 text-sm text-foreground/80">
          <span class="i-lucide-diagram-2"></span>
          <span class="mermaid-modal-title truncate">图表预览</span>
        </div>
        <div class="mermaid-modal-zoom flex shrink-0 items-center gap-1 text-sm">
          <button type="button" data-action="zoom-out" class="mermaid-modal-btn" title="缩小 (-)">−</button>
          <button type="button" data-action="zoom-reset" class="mermaid-modal-btn min-w-[3.5rem]" title="复位 (0)">100%</button>
          <button type="button" data-action="zoom-in" class="mermaid-modal-btn" title="放大 (+)">+</button>
          <span class="mx-1 hidden h-4 w-px bg-border sm:inline-block"></span>
          <button type="button" data-action="toggle-source" class="mermaid-modal-btn" title="查看源码">{}</button>
          <span class="mx-1 hidden h-4 w-px bg-border sm:inline-block"></span>
          <button type="button" data-action="export-svg" class="mermaid-modal-btn px-1.5" title="导出为 SVG" aria-label="导出为 SVG">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          </button>
          <span class="mx-1 hidden h-4 w-px bg-border sm:inline-block"></span>
          <button type="button" data-action="close" class="mermaid-modal-btn" title="关闭 (Esc)" aria-label="关闭">✕</button>
        </div>
      </div>
      <div class="mermaid-modal-stage relative flex-1 overflow-hidden">
        <div class="mermaid-modal-pane absolute inset-0 flex items-center justify-center overflow-auto p-4">
          <div class="mermaid-modal-canvas inline-block origin-center"></div>
        </div>
        <pre class="mermaid-modal-source absolute inset-0 hidden overflow-auto bg-slate-950 p-4 text-xs leading-relaxed text-slate-100"><code></code></pre>
      </div>
      <div class="mermaid-modal-hint shrink-0 border-t border-border/60 bg-background/90 px-3 py-1.5 text-center text-xs text-foreground/60">
        <span class="hidden sm:inline">滚轮缩放 · 拖动平移 · </span>Esc 关闭
      </div>
    `;
    document.body.appendChild(mermaidModal);

    // ── 按钮事件 ─────────────────────────────────────
    mermaidModal
      .querySelector('[data-action="close"]')
      .addEventListener("click", closeMermaidModal);
    // ── 导出按钮：直接导出 SVG ─────────────────────
    mermaidModal
      .querySelector('[data-action="export-svg"]')
      .addEventListener("click", (e) => {
        e.stopPropagation();
        exportMermaidDiagram();
      });
    mermaidModal
      .querySelector('[data-action="zoom-in"]')
      .addEventListener("click", () => zoomModal(1.2));
    mermaidModal
      .querySelector('[data-action="zoom-out"]')
      .addEventListener("click", () => zoomModal(1 / 1.2));
    mermaidModal
      .querySelector('[data-action="zoom-reset"]')
      .addEventListener("click", () => resetModal());
    mermaidModal
      .querySelector('[data-action="toggle-source"]')
      .addEventListener("click", toggleMermaidSource);

    // ── 滚轮缩放（Ctrl/Cmd + 滚轮 或 双指捏合） ──────
    const pane = mermaidModal.querySelector(".mermaid-modal-pane");
    pane.addEventListener(
      "wheel",
      (e) => {
        if (!e.ctrlKey && !e.metaKey && Math.abs(e.deltaY) < 50) return;
        e.preventDefault();
        const factor = e.deltaY < 0 ? 1.1 : 1 / 1.1;
        zoomModal(factor, e.clientX, e.clientY);
      },
      { passive: false }
    );

    // ── 拖动平移 ─────────────────────────────────────
    let dragState = null;
    pane.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      if (e.target.closest("button")) return;
      dragState = {
        startX: e.clientX,
        startY: e.clientY,
        tx: mermaidModalState.tx,
        ty: mermaidModalState.ty,
      };
      pane.setPointerCapture(e.pointerId);
      pane.style.cursor = "grabbing";
    });
    pane.addEventListener("pointermove", (e) => {
      if (!dragState) return;
      mermaidModalState.tx = dragState.tx + (e.clientX - dragState.startX);
      mermaidModalState.ty = dragState.ty + (e.clientY - dragState.startY);
      applyModalTransform();
    });
    pane.addEventListener("pointerup", (e) => {
      if (!dragState) return;
      pane.releasePointerCapture(e.pointerId);
      pane.style.cursor = "";
      dragState = null;
    });
    pane.addEventListener("pointercancel", () => {
      dragState = null;
      pane.style.cursor = "";
    });

    return mermaidModal;
  }

  function openMermaidModal(svgString, sourceCode) {
    const modal = ensureMermaidModal();
    const canvas = modal.querySelector(".mermaid-modal-canvas");
    const sourceEl = modal.querySelector(".mermaid-modal-source code");
    canvas.innerHTML = svgString;
    sourceEl.textContent = sourceCode || "";

    // 复位 transform
    mermaidModalState = { scale: 1, tx: 0, ty: 0, dragging: false };
    applyModalTransform();

    // 显示
    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";

    // 自动 fit 到视口（仅首次）
    requestAnimationFrame(() => fitModalToViewport());
  }

  function closeMermaidModal() {
    if (!mermaidModal) return;
    mermaidModal.classList.add("hidden");
    document.body.style.overflow = "";
    // 把 source 视图也关掉，下次默认显示图表
    const source = mermaidModal.querySelector(".mermaid-modal-source");
    if (source) source.classList.add("hidden");
    const pane = mermaidModal.querySelector(".mermaid-modal-pane");
    if (pane) pane.classList.remove("hidden");
    const btn = mermaidModal.querySelector('[data-action="toggle-source"]');
    if (btn) btn.classList.remove("mermaid-modal-btn-active");
  }

  function applyModalTransform() {
    const canvas = mermaidModal.querySelector(".mermaid-modal-canvas");
    canvas.style.transform = `translate(${mermaidModalState.tx}px, ${mermaidModalState.ty}px) scale(${mermaidModalState.scale})`;
    const label = mermaidModal.querySelector('[data-action="zoom-reset"]');
    if (label)
      label.textContent = Math.round(mermaidModalState.scale * 100) + "%";
  }

  function zoomModal(factor, originX, originY) {
    const next = Math.min(8, Math.max(0.2, mermaidModalState.scale * factor));
    if (next === mermaidModalState.scale) return;

    // 围绕鼠标位置缩放
    if (originX !== undefined && originY !== undefined) {
      const pane = mermaidModal.querySelector(".mermaid-modal-pane");
      const rect = pane.getBoundingClientRect();
      const cx = rect.width / 2 - mermaidModalState.tx;
      const cy = rect.height / 2 - mermaidModalState.ty;
      const dx = originX - rect.left - cx;
      const dy = originY - rect.top - cy;
      const ratio = next / mermaidModalState.scale;
      mermaidModalState.tx -= dx * (ratio - 1);
      mermaidModalState.ty -= dy * (ratio - 1);
    }
    mermaidModalState.scale = next;
    applyModalTransform();
  }

  function resetModal() {
    mermaidModalState = { scale: 1, tx: 0, ty: 0, dragging: false };
    applyModalTransform();
  }

  function fitModalToViewport() {
    const svg = mermaidModal.querySelector(".mermaid-modal-canvas svg");
    const pane = mermaidModal.querySelector(".mermaid-modal-pane");
    if (!svg || !pane) return;
    const svgRect = svg.getBoundingClientRect();
    const paneRect = pane.getBoundingClientRect();
    if (svgRect.width === 0 || svgRect.height === 0) return;
    const scaleX = (paneRect.width - 32) / svgRect.width;
    const scaleY = (paneRect.height - 32) / svgRect.height;
    const fit = Math.min(1, scaleX, scaleY);
    if (fit < 1) {
      mermaidModalState.scale = fit;
      applyModalTransform();
    }
  }

  function toggleMermaidSource() {
    if (!mermaidModal) return;
    const pane = mermaidModal.querySelector(".mermaid-modal-pane");
    const source = mermaidModal.querySelector(".mermaid-modal-source");
    const btn = mermaidModal.querySelector('[data-action="toggle-source"]');
    const hidden = source.classList.toggle("hidden");
    pane.classList.toggle("hidden", !hidden);
    btn.classList.toggle("mermaid-modal-btn-active", !hidden);
  }

  // ─────────────────────────────────────────────
  //  导出图表：PNG / SVG / 复制到剪贴板
  // ─────────────────────────────────────────────
  function getMermaidExportContext() {
    const svg = mermaidModal?.querySelector(
      ".mermaid-modal-canvas > svg"
    );
    if (!svg) return null;
    const container = svg.closest(".mermaid-container");
    const containers = document.querySelectorAll(".mermaid-container");
    const index =
      container && containers.length
        ? Array.from(containers).indexOf(container) + 1
        : 1;
    const slugMatch = window.location.pathname.match(/\/posts\/([^/]+)/);
    const slug = slugMatch ? slugMatch[1] : "mermaid";
    return { svg, index, slug };
  }

  // 把 SVG 做成"干净副本"：
  //  1) 补 xmlns / xmlns:xlink
  //  2) 用 viewBox 算真实尺寸，太小就放大到至少 1200px 长边
  //  3) 内联 mermaid 主题 CSS（关键！否则 PNG 是黑乎乎一片）
  //  4) 补一个背景 rect，跟随当前主题
  //  5) 解除当前画布上的 transform / inline style
  function prepareSvgForExport(srcSvg) {
    const clone = srcSvg.cloneNode(true);
    // 解除当前 canvas 上的缩放/位移
    clone.removeAttribute("style");
    clone.removeAttribute("transform");

    // 确保 xmlns
    if (!clone.getAttribute("xmlns")) {
      clone.setAttribute("xmlns", "http://www.w3.org/2000/svg");
    }
    if (!clone.getAttribute("xmlns:xlink")) {
      clone.setAttribute("xmlns:xlink", "http://www.w3.org/1999/xlink");
    }

    // ── 真实尺寸：优先 viewBox（这是 Mermaid 的逻辑坐标） ──
    const viewBox = clone.getAttribute("viewBox");
    let vbW = 0,
      vbH = 0;
    if (viewBox) {
      const parts = viewBox.split(/[\s,]+/).map(parseFloat);
      vbW = parts[2] || 0;
      vbH = parts[3] || 0;
    }
    let width = vbW;
    let height = vbH;
    if (!width || !height) {
      width = parseFloat(clone.getAttribute("width")) || 0;
      height = parseFloat(clone.getAttribute("height")) || 0;
    }
    if (!width || !height) {
      const rect = srcSvg.getBoundingClientRect();
      width = width || rect.width || 800;
      height = height || rect.height || 600;
    }
    // 最小尺寸：长边至少 1200px，避免导出后看着像缩略图
    const MIN_LONG = 1200;
    const long = Math.max(width, height);
    if (long < MIN_LONG) {
      const k = MIN_LONG / long;
      width = Math.round(width * k);
      height = Math.round(height * k);
    }
    // 保留 viewBox 让矢量缩放永远正确
    if (!viewBox) {
      clone.setAttribute("viewBox", `0 0 ${vbW || width} ${vbH || height}`);
    }
    clone.setAttribute("width", width);
    clone.setAttribute("height", height);

    // ── 内联主题 CSS（关键修复） ──
    if (mermaidThemeCSS) {
      const styleEl = document.createElementNS(
        "http://www.w3.org/2000/svg",
        "style"
      );
      styleEl.setAttribute("type", "text/css");
      // 用 CDATA 包裹，避免选择器被 XML 解析器误解
      styleEl.textContent = `/* <![CDATA[ */\n${mermaidThemeCSS}\n/* ]]> */`;
      // 插到第一个元素前（背景 rect 之后）
      clone.insertBefore(styleEl, clone.firstChild);
    }

    // ── 补背景 rect（跟随当前主题） ──
    const isDark = document.documentElement.dataset.theme === "dark";
    const bg = isDark ? "#0f172a" : "#ffffff";
    const bgRect = document.createElementNS(
      "http://www.w3.org/2000/svg",
      "rect"
    );
    bgRect.setAttribute("x", "0");
    bgRect.setAttribute("y", "0");
    bgRect.setAttribute("width", "100%");
    bgRect.setAttribute("height", "100%");
    bgRect.setAttribute("fill", bg);
    clone.insertBefore(bgRect, clone.firstChild);

    return { clone, width, height, bg };
  }

  function triggerDownload(blob, filename) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  function flashExportButton(ok = true) {
    const btn = mermaidModal?.querySelector('[data-action="export-svg"]');
    if (!btn) return;
    btn.style.color = ok ? "rgb(34 197 94)" : "rgb(239 68 68)";
    setTimeout(() => {
      btn.style.color = "";
    }, 1200);
  }

  async function exportMermaidDiagram() {
    const ctx = getMermaidExportContext();
    if (!ctx) {
      flashExportButton("无图表", false);
      return;
    }
    const baseName = `${ctx.slug}-${String(ctx.index).padStart(2, "0")}`;

    try {
      const { clone } = prepareSvgForExport(ctx.svg);
      const xml = new XMLSerializer().serializeToString(clone);
      const blob = new Blob(
        ['<?xml version="1.0" encoding="UTF-8"?>\n', xml],
        { type: "image/svg+xml;charset=utf-8" }
      );
      triggerDownload(blob, `${baseName}.svg`);
      flashExportButton(true);
    } catch (err) {
      console.warn("Mermaid export failed:", err);
      flashExportButton("导出失败", false);
    }
  }

  // ── 全局快捷键：Esc 关闭、+/− 缩放、0 复位 ───────
  document.addEventListener("keydown", (e) => {
    if (!mermaidModal || mermaidModal.classList.contains("hidden")) return;
    if (e.key === "Escape") {
      e.preventDefault();
      closeMermaidModal();
    } else if (e.key === "+" || e.key === "=") {
      e.preventDefault();
      zoomModal(1.2);
    } else if (e.key === "-" || e.key === "_") {
      e.preventDefault();
      zoomModal(1 / 1.2);
    } else if (e.key === "0") {
      e.preventDefault();
      resetModal();
    }
  });
</script>

